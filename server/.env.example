PORT=5000
NODE_ENV=development

# Comma-separated list of allowed frontend origins (local + deployed)
FRONTEND_URL=http://localhost:5173

# Optional regex allowlist for dynamic preview URLs (e.g. Vercel preview domains)
# Example: ^https://the-best-group-of-colleges-fullstack-.*\.vercel\.app$
FRONTEND_URL_REGEX=

# Optional public API base for local upload fallback URLs
# In Render this can be left empty because RENDER_EXTERNAL_URL is auto-injected
SERVER_PUBLIC_URL=

MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_ACCESS_SECRET=replace_with_long_random_secret
JWT_REFRESH_SECRET=replace_with_long_random_secret
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE_DAYS=7

CLOUDINARY_CLOUD_NAME=replace_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_cloudinary_api_secret

SEED_SUPER_ADMIN_ID=ADM-1000
SEED_SUPER_ADMIN_EMAIL=admin@bestcollege.edu
SEED_SUPER_ADMIN_PASSWORD=replace_with_strong_password
